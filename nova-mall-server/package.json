{
  "name": "nova-mall-server",
  "version": "1.0.0",
  "description": "DaveBella 会员端（小程序/手机端）API 服务",
  "license": "ISC",
  "main": "dist/index.js",
  "scripts": {
    "dev:compiler": "tsc -p tsconfig.server.json -w",
    "dev:server": "mkdir -p dist && nodemon --watch dist --delay 500ms dist/index.js",
    "dev": "concurrently -k -n COMPILER,SERVER -c green,blue \"npm run dev:compiler\" \"npm run dev:server\"",
    "build": "tsc -p tsconfig.server.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm run lint"
    }
  },
  "dependencies": {
    "axios": "^1.6.8",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.11",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "lodash-es": "^4.17.21",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.11.5",
    "sequelize": "^6.37.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.18.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.18.1",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.1.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": "^7.0.4",
    "nodemon": "^3.1.11",
    "prettier": "^2.6.2",
    "terser": "^5.14.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
