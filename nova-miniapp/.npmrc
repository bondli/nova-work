# 固定使用官方 npm 源，避免 package-lock.json 里写入公司内网源地址
registry=https://registry.npmjs.org/
# 生成/安装时把历史 lock 里的内网源地址统一改写为上面的源
replace-registry-host=always
# Taro 的 @tarojs/plugin-framework-react 声明了可选 peer vite@^4，
# 而 devDependencies 里的 vitest@2 需要 vite@^5，npm 默认严格 peer 校验会冲突；
# 本项目用 webpack5 构建，不装 vite@4，因此放开 peer 严格校验（与 Taro 官方模板一致）
legacy-peer-deps=true
