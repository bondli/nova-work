    "@tarojs/components": "4.1.8",
    "@tarojs/react": "4.1.8",
    "@tarojs/runtime": "4.1.8",
    "@tarojs/taro": "4.1.8",
    "ajv": "^8.20.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-react": "^7.24.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.1",
    "@tarojs/cli": "4.1.8",
    "@tarojs/helper": "4.1.8",
