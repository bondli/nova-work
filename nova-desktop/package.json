{
  "name": "nova-desktop",
  "version": "1.0.0",
  "description": "DaveBella 门店经营工作台 - 桌面端",
  "main": "./out/main/index.js",
  "author": "DaveBella",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "npm run build && playwright test",
    "pack": "npm run build && electron-builder --mac --publish never",
    "pack:mac": "npm run build && electron-builder --mac --publish never",
    "pack:win": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
