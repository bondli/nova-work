{
  "name": "nova-pos-server",
  "description": "DaveBella 门店经营工作台 - POS API 服务",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.server.json",
    "dev": "tsc -p tsconfig.server.json && nodemon --watch dist --delay 500ms dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.11",
    "decimal.js": "^10.5.0",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "lodash-es": "^4.17.21",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.11.5",
    "sequelize": "^6.37.3",
    "uuid": "^10.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.41"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.1.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "nodemon": "^3.1.11",
    "prettier": "^2.6.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
